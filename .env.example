# Copy to .env.local and fill in before launch.
# Until these are set, enquiries are validated and logged server-side but no
# email is delivered — see lib/email.ts.

# Resend API key — https://resend.com (free tier covers a site this size)
RESEND_API_KEY=

# Verified sending address on the Ushine domain, e.g. enquiries@ushine247.com.au
# The domain must be verified in Resend (SPF + DKIM DNS records) or mail bounces.
ENQUIRY_FROM_EMAIL=
